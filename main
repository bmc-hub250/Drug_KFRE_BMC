\cb3     const App = () => \{\cb1 \
\cb3       const [formData, setFormData] = useState(\{\cb1 \
\cb3         name: '', age: '', gender: 'Male',\cb1 \
\cb3         bun: '', cr: '', gfr: '', \cb1 \
