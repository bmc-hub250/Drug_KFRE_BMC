\cb3       // Med Handlers\cb1 \
\cb3       const handleMedInputKeyDown = (e, nextRef, isLast) => \{\cb1 \
\cb3         if (e.key === 'Enter') \{ e.preventDefault(); e.stopPropagation(); if (isLast) addMed(); else if (nextRef && nextRef.current) nextRef.current.focus(); \}\cb1 \
\cb3       \};\cb1 \
\cb3       \cb1 \
