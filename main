\cb3     const medSuggestions = [\cb1 \
\cb3       "Amlodipine", "Atenolol", "Bisoprolol", "Carvedilol", "Clonidine", "Diltiazem", "Doxazosin", \cb1 \
\cb3       "Enalapril", "Furosemide", "Hydralazine", "Hydrochlorothiazide (HCTZ)", "Losartan", "Manidipine", \cb1 \
