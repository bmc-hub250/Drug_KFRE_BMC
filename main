\cb3     const calculateKFRE = (age, gender, egfr, uacr) => \{\cb1 \
\cb3         const a = parseFloat(age);\cb1 \
\cb3         const e = parseFloat(egfr);\cb1 \
\cb3         const u = parseFloat(uacr);\cb1 \
\cb3         if (isNaN(a) || isNaN(e) || isNaN(u) || e <= 0 || u <= 0) return null;\cb1 \
\
\cb3         const sex = gender === 'Male' ? 1 : 0;\cb1 \
\cb3         const termAge  = -0.2201 * ((a / 10) - 7.036);\cb1 \
\cb3         const termSex  = 0.2467 * (sex - 0.5642);\cb1 \
\cb3         const termEgfr = -0.5567 * ((e / 5) - 7.222);\cb1 \
\cb3         const termUacr = 0.4510 * (Math.log(u) - 5.137);\cb1 \
\
\cb3         const xBeta = termAge + termSex + termEgfr + termUacr;\cb1 \
\cb3         const s0_2year = 0.9832;\cb1 \
\cb3         const s0_5year = 0.9365;\cb1 \
\
\cb3         const risk2YrDecimal = 1 - Math.pow(s0_2year, Math.exp(xBeta));\cb1 \
\cb3         const risk5YrDecimal = 1 - Math.pow(s0_5year, Math.exp(xBeta));\cb1 \
\
\cb3         const risk2Year = Math.max(0, Math.min(100, risk2YrDecimal * 100));\cb1 \
\cb3         const risk5Year = Math.max(0, Math.min(100, risk5YrDecimal * 100));\cb1 \
\
\cb3         let recommendation = "";\cb1 \
\cb3         if (risk2Year > 40) \{\cb1 \
\cb3             recommendation = "Begin KRT preparation and modality education";\cb1 \
\cb3         \} else if (risk2Year > 10) \{\cb1 \
\cb3             recommendation = "Initiate multidisciplinary care to delay CKD progression";\cb1 \
\cb3         \}\cb1 \
\
\cb3         return \{ risk2: risk2Year.toFixed(2), risk5: risk5Year.toFixed(2), rec: recommendation \};\cb1 \
\cb3     \};\cb1 \
\
\cb3     // --- Components ---\cb1 \
\cb3     const AutocompleteInput = (\{ value, onChange, onKeyDown, placeholder, className, suggestionsList, innerRef, ...props \}) => \{\cb1 \
\cb3       const [suggestion, setSuggestion] = useState('');\cb1 \
\cb3       useEffect(() => \{\cb1 \
\cb3         if (!value || value.length < 2) \{ setSuggestion(''); return; \}\cb1 \
\cb3         const match = suggestionsList.find(s => s.toLowerCase().startsWith(value.toLowerCase()));\cb1 \
\cb3         if (match) setSuggestion(value + match.substring(value.length));\cb1 \
\cb3         else setSuggestion('');\cb1 \
\cb3       \}, [value, suggestionsList]);\cb1 \
\
\cb3       const handleKeyDown = (e) => \{\cb1 \
\cb3         if ((e.key === 'Enter' || e.key === 'Tab' || e.key === 'ArrowRight') && suggestion && suggestion.toLowerCase() !== value.toLowerCase()) \{\cb1 \
\cb3           e.preventDefault(); e.stopPropagation();\cb1 \
\cb3           onChange(\{ target: \{ value: suggestion, name: props.name \} \});\cb1 \
\cb3         \} else \{ if (onKeyDown) onKeyDown(e); \}\cb1 \
\cb3       \};\cb1 \
\
\cb3       return (\cb1 \
\cb3         <div className=\{`relative flex flex-1`\}>\cb1 \
\cb3           <input ref=\{innerRef\} type="text" value=\{value\} onChange=\{onChange\} onKeyDown=\{handleKeyDown\} placeholder=\{placeholder\} className=\{`$\{className\} w-full relative z-10 bg-white/70 backdrop-blur-sm border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 rounded-lg p-2.5 text-sm transition-all outline-none`\} \{...props\} />\cb1 \
\cb3           \{suggestion && suggestion.toLowerCase().startsWith(value.toLowerCase()) && (\cb1 \
\cb3             <div className=\{`absolute inset-0 pointer-events-none p-2.5 text-sm font-sans flex items-center overflow-hidden whitespace-pre z-20`\}>\cb1 \
\cb3                <span className="text-transparent">\{value\}</span>\cb1 \
\cb3                <span className="text-slate-400 font-semibold">\{suggestion.substring(value.length)\}</span>\cb1 \
\cb3             </div>\cb1 \
\cb3           )\}\cb1 \
\cb3         </div>\cb1 \
\cb3       );\cb1 \
\cb3     \};\cb1 \
